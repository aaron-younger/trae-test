//@version=5
strategy("优化波动扩张收盘策略(T+1)", 
     overlay=false,
     pyramiding=0,
     default_qty_value=5000,
     initial_capital=500000,
     close_entries_rule="FIFO",
     commission_type=strategy.commission.percent,
     commission_value=0.03)

isNewDay = ta.change(time("D"))
var int tradeDay = 0
if isNewDay
    tradeDay += 1

volatilityPeriod = input.int(20, "波动率周期")
expansionFactor = input.float(2.0, "扩张系数", step=0.1)
stopLossMultiplier = input.float(2.0, "止损倍数", step=0.1)
takeProfitMultiplier = input.float(3.0, "止盈倍数", step=0.1)

atrValue = ta.atr(volatilityPeriod)
isExpanding = ta.tr > atrValue * expansionFactor

closePosition = (close - low) / (high - low)
isCloseHigh = closePosition > 0.7
isCloseLow = closePosition < 0.3

volSMA = ta.sma(volume, 20)
longCondition = isExpanding and isCloseHigh and volume > volSMA

var bool hasPosition = false
var int entryDay = na
var float entryPrice = na

if longCondition and not hasPosition
    strategy.entry("Volty_Long", strategy.long, comment="B")
    hasPosition := true
    entryDay := tradeDay
    entryPrice := close

if hasPosition
    stopLoss = entryPrice - atrValue * stopLossMultiplier
    takeProfit = entryPrice + atrValue * takeProfitMultiplier
    
    if (isExpanding and isCloseLow and tradeDay > entryDay) or low <= stopLoss or high >= takeProfit
        strategy.close("Volty_Long", comment="S")
        hasPosition := false
