//@version=5
strategy("波动扩张收盘策略(T+1)", 
     overlay=true,
     pyramiding=0,
     default_qty_value=5000,
     initial_capital=500000,
     close_entries_rule="FIFO")

// 交易日计数
isNewDay18 = ta.change(time("D"))
var int tradeDay18 = 0
if isNewDay18
    tradeDay18 += 1

// 参数
volatilityPeriod = input.int(20, "波动率周期")
expansionFactor = input.float(2.0, "扩张系数", step=0.1)

// 波动率计算
trueRange = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
atrValue18 = ta.sma(trueRange, volatilityPeriod)

// 波动扩张判断
isExpanding = trueRange > atrValue18 * expansionFactor

// 收盘位置判断
closePosition = (close - low) / (high - low)
isCloseHigh = closePosition > 0.7
isCloseLow = closePosition < 0.3

// 交易信号
longCondition18 = isExpanding and isCloseHigh and volume > ta.sma(volume, 20)
exitCondition18 = isExpanding and isCloseLow

// 持仓跟踪
var bool hasPosition18 = false
var int entryDay18 = na

// 交易执行
if longCondition18 and not hasPosition18
    strategy.entry("Volty_Long", strategy.long, comment="B")
    hasPosition18 := true
    entryDay18 := tradeDay18

if exitCondition18 and hasPosition18 and tradeDay18 > entryDay18
    strategy.close("Volty_Long", comment="S")
    hasPosition18 := false

// ==================== 买卖标识 ====================
// 买入标记 - 绿色大三角形
plotshape(longCondition18 and not hasPosition18[1], title="买入B", style=shape.triangleup, location=location.bottom, color=color.green, size=size.large, textcolor=color.white)

// 卖出标记 - 红色大三角形
plotshape(exitCondition18 and hasPosition18[1] and tradeDay18 > entryDay18[1], title="卖出S", style=shape.triangledown, location=location.top, color=color.red, size=size.large, textcolor=color.white)

// B/S文字标注
plotshape(longCondition18 and not hasPosition18[1], title="B文字", text="B", style=shape.labelup, location=location.belowbar, color=color.green, textcolor=color.white, size=size.normal)
plotshape(exitCondition18 and hasPosition18[1] and tradeDay18 > entryDay18[1], title="S文字", text="S", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, size=size.normal)
