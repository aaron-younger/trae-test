//@version=5
strategy("波动扩张收盘策略(T+1)完整版", 
     overlay=false,
     pyramiding=0,
     default_qty_value=5000,
     initial_capital=500000,
     close_entries_rule="FIFO",
     commission_type=strategy.commission.percent,
     commission_value=0.03,
     slippage=0.1,
     margin_long=100,
     margin_short=100)

// ==================== 交易日计数 ====================
isNewDay = ta.change(time("D"))
var int tradeDay = 0
if isNewDay
    tradeDay += 1

// ==================== 参数设置 ====================
// 核心参数
volatilityPeriod = input.int(20, "波动率周期")
expansionFactor = input.float(2.0, "扩张系数", step=0.1)

// 趋势过滤参数
useTrendFilter = input.bool(true, "启用均线趋势过滤")
trendLength = input.int(20, "趋势均线周期")

// 止损止盈参数
useStopLoss = input.bool(true, "启用ATR动态止损")
stopLossAtrMultiplier = input.float(1.5, "止损ATR倍数", step=0.1)
useTakeProfit = input.bool(true, "启用固定止盈")
takeProfitPct = input.float(3.0, "止盈百分比", step=0.1)

// 持仓时间参数
maxHoldDays = input.int(2, "最大持仓天数")

// 成交量过滤参数
volMultiplier = input.float(1.5, "成交量倍数", step=0.1)

// 卖出条件优化
useFlexibleExit = input.bool(true, "启用灵活卖出（弱势收盘即卖）")

// ==================== 基础计算 ====================
// 波动率计算
trueRange = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
atrValue = ta.sma(trueRange, volatilityPeriod)

// 波动扩张判断
isExpanding = trueRange > atrValue * expansionFactor

// 收盘位置判断
closePosition = (close - low) / (high - low)
isCloseHigh = closePosition > 0.7
isCloseLow = closePosition < 0.3

// 均线趋势
maTrend = ta.sma(close, trendLength)
isUptrend = close > maTrend

// 成交量过滤
volSMA = ta.sma(volume, 20)
volumeEnough = volume > volSMA * volMultiplier

// ==================== 开仓条件 ====================
longCondition = true

// 原策略核心条件
longCondition := longCondition and isExpanding and isCloseHigh and volumeEnough

// 趋势过滤
if useTrendFilter
    longCondition := longCondition and isUptrend

// ==================== 持仓跟踪 ====================
var bool hasPosition = false
var int entryDay = na
var float entryPrice = na

// 开仓
if longCondition and not hasPosition
    strategy.entry("Volty_Long", strategy.long, comment="B")
    hasPosition := true
    entryDay := tradeDay
    entryPrice := close

// ==================== 平仓条件 ====================
var bool exitTriggered = false
exitTriggered := false

if hasPosition
    // 1. 原策略平仓条件
    originalExit = isExpanding and isCloseLow and tradeDay > entryDay
    
    // 2. 灵活卖出条件（即使没有波动扩张，弱势收盘也卖）
    flexibleExit = useFlexibleExit and isCloseLow and tradeDay > entryDay
    
    // 3. ATR止损
    atrStopLoss = na
    if useStopLoss
        atrStopLoss = entryPrice - atrValue * stopLossAtrMultiplier
        atrStopLossExit = low <= atrStopLoss
    else
        atrStopLossExit = false
    
    // 4. 固定止盈
    takeProfitPrice = na
    if useTakeProfit
        takeProfitPrice = entryPrice * (1 + takeProfitPct / 100)
        takeProfitExit = high >= takeProfitPrice
    else
        takeProfitExit = false
    
    // 5. 无条件清仓（超过最大持仓天数）
    timeExit = tradeDay > entryDay + maxHoldDays - 1
    
    // 综合判断
    exitTriggered := originalExit or flexibleExit or atrStopLossExit or takeProfitExit or timeExit

// 执行平仓
if exitTriggered
    strategy.close("Volty_Long", comment="S")
    hasPosition := false
